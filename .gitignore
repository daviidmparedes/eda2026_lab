# ---------------------------------------------------------------
# Material que NO se publica
# ---------------------------------------------------------------
# El libro del curso se entrega por otro canal
*.pdf

# Enunciados de cada laboratorio: por defecto se distribuyen aparte, no por el repo.
# Los de lab1 y lab2 explican la solucion completa y traen los tiempos de referencia.
lab*/README.md
# Excepcion: el del lab3 es el enunciado para el estudiante, ya separado de la
# copia docente (que vive en lab3/solution/ y por eso queda fuera).
!lab3/README.md

# Enunciados de prueba: se entregan por otro canal
eda_c*.png

# Solucion del lab3: se publica mas adelante, por ahora solo va el starter
lab3/solution/

# Configuracion local del editor
.vscode/

# Trabajo en curso local
_wip/

# ---------------------------------------------------------------
# Artefactos de compilacion
# ---------------------------------------------------------------
# Se regenera con: mkdir build && cd build && cmake .. && make
build/
*.o
*.out

# ---------------------------------------------------------------
# Salidas generadas
# ---------------------------------------------------------------
# Los .csv los escribe ./test y los .png los generan los scripts de python.
# Ambos quedan dentro de la carpeta python/ del ejercicio y se regeneran.
**/python/*.csv
**/python/*.png

# ---------------------------------------------------------------
# Sistema
# ---------------------------------------------------------------
.DS_Store
__pycache__/
*.pyc
